{
  "//": "Configuration propre à la fonction serveur Vercel : CommonJS, indépendante du build Angular.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/app/data/profile.ts"]
}
